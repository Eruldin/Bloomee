# Yayın imzalama ayarları — bu dosyayı "keystore.properties" olarak kopyala,
# değerleri doldur ve repo kökünde bırak. keystore.properties ve .jks dosyaları
# gitignore'lu; ASLA repoya commit'leme.
#
# Keystore yoksa tek seferlik oluştur:
#   keytool -genkeypair -v -keystore bloomee-release.jks -alias bloomee \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Bu keystore'u yedekle ve güvende tut: Play Store güncellemeleri aynı
# anahtarı gerektirir; kaybedersen uygulama güncellenemez.

storeFile=bloomee-release.jks
storePassword=
keyAlias=bloomee
keyPassword=
